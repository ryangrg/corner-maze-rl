# personal experimental code
dt-build

# Run outputs / model artifacts
runs/
model-data/

# Per-session yoked parquets (intermediate artifacts; regeneratable from upstream
# via corner-maze-build-yoked). The aggregated dataset at data/yoked/dataset/
# IS committed.
data/yoked/*.parquet
**/data/yoked/*.parquet

# Notebooks that auto-download data relative to their own CWD end up with
# a redundant data/ tree under notebooks/. The canonical data lives at the
# repo-root data/.
notebooks/data/

# Student experiment scratch. Canonical notebooks live at the top of
# notebooks/; students copy them into notebooks/students/<name>/ and tweak
# freely. The students/ folder itself + its README/.gitkeep are tracked;
# per-student subdirs are not. Sharing happens via fork/PR or by promoting
# a copy into notebooks/contrib/<name>/ (which is NOT gitignored).
notebooks/students/*/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Local notebook copies for experimentation (e.g. 10a_local.ipynb)
notebooks/*_local.ipynb
